DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
NOTIFICATION_CHANNEL_ID=
DEFAULT_SHUTDOWN_HOURS=6
MAX_SHUTDOWN_HOURS=24

# Each game is enabled by setting its container name. Leave it blank to disable
# that game's slash commands entirely. At least one must be set.

# --- V Rising ---
VRISING_CONTAINER_NAME=
# Optional: metrics API for player count in /status and auto-shutdown logic
# Requires API.Enabled=true in ServerHostSettings.json and port 9090 published
VRISING_METRICS_URL=http://<game-server-host>:9090/metrics
# Optional: RCON for in-game announcements when auto-shutdown is extended
# Requires Rcon.Enabled=true in ServerHostSettings.json and port 25575 published
VRISING_RCON_HOST=<game-server-host>
VRISING_RCON_PORT=25575
VRISING_RCON_PASSWORD=

# --- Factorio ---
FACTORIO_CONTAINER_NAME=
# Optional but recommended: RCON powers player count, in-game announcements, and
# /server-save before every stop. Requires port 27015/tcp published; the password
# is in data/config/rconpw on the server (generated on first start).
FACTORIO_RCON_HOST=<game-server-host>
FACTORIO_RCON_PORT=27015
FACTORIO_RCON_PASSWORD=
