DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
TARGET_CONTAINER_NAME=
NOTIFICATION_CHANNEL_ID=
DEFAULT_SHUTDOWN_HOURS=6
MAX_SHUTDOWN_HOURS=24

# Optional: metrics API for player count in /status and auto-shutdown logic
# Requires API.Enabled=true in ServerHostSettings.json and port 9090 published
VRISING_METRICS_URL=http://<game-server-host>:9090/metrics

# Optional: RCON for in-game announcements when auto-shutdown is extended
# Requires Rcon.Enabled=true in ServerHostSettings.json and port 25575 published
RCON_HOST=<game-server-host>
RCON_PORT=25575
RCON_PASSWORD=
